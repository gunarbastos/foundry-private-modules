<div class="es-player-panel">

  <!-- ═══════════════════════════════════════════════════════════════
       HEADER
       ═══════════════════════════════════════════════════════════════ -->
  <header class="es-player-panel__header">
    <div class="es-player-panel__title">
      <i class="fas fa-theater-masks"></i>
      <span>{{localize "EXALTED-SCENES.PlayerPanel.MyCharacters"}}</span>
    </div>
    <div class="es-player-panel__header-actions">
      {{#if isBroadcasting}}
        <span class="es-player-panel__badge es-player-panel__badge--live">
          <i class="fas fa-broadcast-tower"></i>
          {{localize "EXALTED-SCENES.Status.SceneActive"}}
        </span>
      {{/if}}
      <button type="button" class="es-btn es-btn-secondary es-btn-sm es-shortcuts-trigger es-player-panel__shortcut-btn {{#if shortcutsOpen}}es-btn--active{{/if}}" data-action="toggle-shortcuts" title="{{shortcutButtonLabel}}" aria-label="{{shortcutButtonLabel}}">
        <i class="fas fa-keyboard"></i>
        <span>{{shortcutButtonLabel}}</span>
      </button>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════════════════════
       CONTENT
       ═══════════════════════════════════════════════════════════════ -->
  {{#if shortcutsOpen}}
    <div class="es-shortcuts-overlay">
      <button type="button" class="es-shortcuts-backdrop" data-action="toggle-shortcuts" aria-label="{{localize "EXALTED-SCENES.Common.Close"}}"></button>
      <section class="es-shortcuts-panel" aria-label="{{shortcutDialogTitle}}">
        <header class="es-shortcuts-header">
          <div class="es-shortcuts-header-copy">
            <div class="es-shortcuts-kicker">{{shortcutButtonLabel}}</div>
            <h2 class="es-shortcuts-title">{{shortcutDialogTitle}}</h2>
            <p class="es-shortcuts-subtitle">{{shortcutDialogHint}}</p>
          </div>
          <button type="button" class="es-btn-icon es-btn-icon--small" data-action="toggle-shortcuts" title="{{localize "EXALTED-SCENES.Common.Close"}}" aria-label="{{localize "EXALTED-SCENES.Common.Close"}}">
            <i class="fas fa-times"></i>
          </button>
        </header>

        <div class="es-shortcuts-groups">
          {{#each shortcutGroups}}
            <section class="es-shortcuts-group">
              <div class="es-shortcuts-group-head">
                <div class="es-shortcuts-group-title">{{label}}</div>
                <div class="es-shortcuts-group-hint">{{description}}</div>
              </div>

              <div class="es-shortcuts-list">
                {{#each items}}
                  <div class="es-shortcut-row">
                    <div class="es-shortcut-copy">
                      <div class="es-shortcut-label-row">
                        <span class="es-shortcut-label">{{label}}</span>
                        {{#if gmOnly}}
                          <span class="es-shortcut-badge">GM</span>
                        {{/if}}
                      </div>
                      <div class="es-shortcut-description">{{description}}</div>
                    </div>

                    <div class="es-shortcut-keys" aria-label="{{label}}">
                      {{#each parts}}
                        <span class="es-shortcut-key">{{this}}</span>
                      {{/each}}
                    </div>
                  </div>
                {{/each}}
              </div>
            </section>
          {{/each}}
        </div>
      </section>
    </div>
  {{/if}}

  <main class="es-player-panel__content">
    {{#if hasCharacters}}
      <p class="es-player-panel__hint">{{localize "EXALTED-SCENES.PlayerPanel.Hint"}}</p>

      <div class="es-player-panel__grid">
        {{#each characters}}
          <div class="es-player-panel__character {{#if locked}}es-player-panel__character--locked{{/if}}"
               data-id="{{id}}"
               data-action="character-click">
            <div class="es-player-panel__portrait" data-effect="{{borderStyle.effect}}" style="{{borderInlineStyle borderStyle}}">
              <img src="{{image}}" alt="{{name}}" style="{{focusStyle}}">
            </div>
            <div class="es-player-panel__info">
              <span class="es-player-panel__name">{{name}}</span>
              <span class="es-player-panel__state">{{currentState}}</span>
            </div>
            {{#if canEditBorder}}
              <button class="es-player-panel__edit-btn" data-action="edit-character" data-id="{{id}}" title="{{localize "EXALTED-SCENES.PlayerPanel.EditCharacter"}}">
                <i class="fas fa-edit"></i>
              </button>
            {{/if}}
            {{#if locked}}
              <div class="es-player-panel__lock" title="{{localize "EXALTED-SCENES.PlayerPanel.LockedByGM"}}">
                <i class="fas fa-lock"></i>
              </div>
            {{/if}}
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="es-player-panel__empty">
        <div class="es-player-panel__empty-icon">
          <i class="fas fa-user-slash"></i>
        </div>
        <h3 class="es-player-panel__empty-title">{{localize "EXALTED-SCENES.PlayerPanel.NoCharactersAssigned"}}</h3>
        <p class="es-player-panel__empty-desc">{{localize "EXALTED-SCENES.PlayerPanel.AskGMForCharacters"}}</p>
      </div>
    {{/if}}
  </main>

  <!-- Emotion Picker Popover -->
  {{#if emotionPicker}}
    <div class="es-emotion-picker {{#if (gt emotionPicker.emotions.length 5)}}es-emotion-picker--has-search{{/if}} {{#if emotionPicker.pickerBelow}}es-emotion-picker--below{{/if}}" style="left: {{emotionPicker.x}}px; top: {{emotionPicker.y}}px;">
      <div class="es-picker-header">
        <div class="es-picker-header-copy">
          <div class="es-picker-header-kicker">
            <i class="fas {{emotionPicker.pickerModeIcon}}"></i>
            <span>{{emotionPicker.pickerModeLabel}}</span>
          </div>
          <div class="es-picker-header-title">{{emotionPicker.character.name}}</div>
        </div>
        <div class="es-picker-actions">
          {{#if emotionPicker.linkedActor}}
            <button class="es-btn-icon es-btn-icon--small es-btn-sheet" data-action="open-actor-sheet" title="{{emotionPicker.openActorTitle}}"><i class="fas fa-address-book"></i></button>
          {{/if}}
          {{#if emotionPicker.hasMusicPlaylist}}
            <button class="es-btn-icon es-btn-icon--small es-btn-music" data-action="open-music-picker" title="{{localize "EXALTED-SCENES.Picker.RequestMusic"}}"><i class="fas fa-music"></i></button>
          {{/if}}
          {{#if emotionPicker.canEditBorder}}
            <button class="es-btn-icon es-btn-icon--small es-btn-palette" data-action="open-border-picker" title="{{localize "EXALTED-SCENES.Picker.BorderStyle"}}"><i class="fas fa-palette"></i></button>
          {{/if}}
          <button class="es-btn-icon es-btn-icon--small" data-action="close-picker" title="{{localize "EXALTED-SCENES.Common.Close"}}"><i class="fas fa-times"></i></button>
        </div>
      </div>
      <div class="es-picker-meta">
        <div class="es-picker-meta-pill es-picker-meta-pill--active" title="{{emotionPicker.activeStateLabel}}">
          <i class="fas fa-bolt"></i>
          <span>{{emotionPicker.activeStateLabel}}</span>
        </div>
        <div class="es-picker-meta-pill" title="{{emotionPicker.pickerModeLabel}}">
          <i class="fas fa-layer-group"></i>
          <span>{{emotionPicker.pickerCount}}</span>
        </div>
      </div>
      {{#if (gt emotionPicker.emotions.length 5)}}
        <div class="es-picker-search">
          <i class="fas fa-search"></i>
          <input type="text" class="es-picker-search-input" placeholder="{{localize "EXALTED-SCENES.Picker.SearchEmotions"}}" aria-label="{{localize "EXALTED-SCENES.Picker.SearchEmotions"}}">
        </div>
      {{/if}}
      <div class="es-picker-grid">
        {{#each emotionPicker.emotions}}
          <div class="es-picker-item {{#if (eq ../emotionPicker.character.currentState key)}}es-picker-item--active{{/if}} {{#if isFavorite}}es-picker-item--favorite{{/if}}"
               data-action="select-emotion"
               data-state="{{key}}"
               data-path="{{path}}"
               title="{{key}}{{#if isFavorite}} {{localize "EXALTED-SCENES.Picker.Favorite"}}{{/if}}">
            <img src="{{path}}" style="{{focusStyle}}">
            <span class="es-picker-label">{{key}}</span>
          </div>
        {{/each}}
      </div>
    </div>
  {{/if}}

  <!-- Music Request Picker Popover -->
  {{#if musicPicker}}
    <div class="es-music-picker {{#if musicPicker.pickerBelow}}es-music-picker--below{{/if}}" style="left: {{musicPicker.x}}px; top: {{musicPicker.y}}px;">
      <div class="es-picker-header">
        <span>{{localize "EXALTED-SCENES.Picker.RequestMusic"}}</span>
        <button class="es-btn-icon es-btn-icon--small" data-action="close-music-picker"><i class="fas fa-times"></i></button>
      </div>
      <div class="es-picker-back" data-action="back-to-emotions-from-music">
        <i class="fas fa-arrow-left"></i> {{localize "EXALTED-SCENES.Picker.BackToEmotions"}}
      </div>

      <div class="es-music-picker__playlist">
        <i class="fas fa-compact-disc"></i>
        <span>{{musicPicker.playlistName}}</span>
        <span class="es-music-picker__count">{{musicPicker.totalTracks}} tracks</span>
      </div>

      {{#if musicPicker.hasSearch}}
        <div class="es-picker-search es-music-picker__search">
          <i class="fas fa-search"></i>
          <input type="text" class="es-music-picker__search-input" placeholder="{{localize "EXALTED-SCENES.MusicPicker.SearchTracks"}}">
        </div>
      {{/if}}

      <div class="es-music-picker__tracks">
        {{#each musicPicker.tracks}}
          <div class="es-music-picker__track"
               data-action="request-track"
               data-track-id="{{id}}"
               data-track-name="{{name}}"
               title="Request: {{name}}">
            <i class="fas fa-play-circle"></i>
            <span class="es-music-picker__track-name">{{name}}</span>
          </div>
        {{else}}
          <div class="es-music-picker__empty">
            <i class="fas fa-volume-mute"></i>
            <span>{{localize "EXALTED-SCENES.MusicPicker.NoTracksFound"}}</span>
          </div>
        {{/each}}
      </div>
    </div>
  {{/if}}

  <!-- Border Picker Popover (v6.0: effect + color) -->
  {{#if borderPicker}}
    <div class="es-border-picker {{#if borderPicker.pickerBelow}}es-border-picker--below{{/if}}" style="left: {{borderPicker.x}}px; top: {{borderPicker.y}}px;">
      <div class="es-picker-header">
        <span>{{localize "EXALTED-SCENES.Picker.BorderStyle"}}</span>
        <button class="es-btn-icon es-btn-icon--small" data-action="close-border-picker"><i class="fas fa-times"></i></button>
      </div>
      <div class="es-picker-back" data-action="back-to-emotions">
        <i class="fas fa-arrow-left"></i> {{localize "EXALTED-SCENES.Picker.BackToEmotions"}}
      </div>

      {{!-- Effect Grid --}}
      <div class="es-border-category">
        <h4>{{localize "EXALTED-SCENES.Border.Effect"}}</h4>
        <div class="es-border-effect-grid">
          {{#each borderPicker.effects}}
            <div class="es-border-effect-option {{#if active}}es-border-effect-option--active{{/if}} {{#if animated}}es-border-effect-option--animated{{/if}}"
                 data-action="select-effect"
                 data-effect="{{key}}"
                 title="{{localize name}}">
              <i class="fas {{icon}}"></i>
              <span>{{localize name}}</span>
            </div>
          {{/each}}
        </div>
      </div>

      {{!-- Color Swatches --}}
      {{#unless borderPicker.noColor}}
      <div class="es-border-category">
        <h4>{{localize "EXALTED-SCENES.Border.Color"}}</h4>
        <div class="es-border-color-row">
          {{#each borderPicker.swatches}}
            <div class="es-border-swatch {{#if active}}es-border-swatch--active{{/if}}"
                 data-action="select-border-color"
                 data-color="{{hex}}"
                 style="background-color: {{hex}}"
                 title="{{key}}">
            </div>
          {{/each}}
          <div class="es-border-custom-color">
            <input type="color" class="es-border-color-input" value="{{borderPicker.currentColor}}" data-target="color1" title="{{localize "EXALTED-SCENES.Border.CustomColor"}}">
          </div>
        </div>
      </div>

      {{!-- Second Color (gradient/ethereal only) --}}
      {{#if borderPicker.showColor2}}
      <div class="es-border-category">
        <h4>{{localize "EXALTED-SCENES.Border.SecondColor"}}</h4>
        <div class="es-border-color-row">
          {{#each borderPicker.swatches}}
            <div class="es-border-swatch {{#if active}}es-border-swatch--active{{/if}}"
                 data-action="select-border-color2"
                 data-color="{{hex}}"
                 style="background-color: {{hex}}"
                 title="{{key}}">
            </div>
          {{/each}}
          <div class="es-border-custom-color">
            <input type="color" class="es-border-color-input" value="{{borderPicker.currentColor2}}" data-target="color2" title="{{localize "EXALTED-SCENES.Border.CustomColor"}}">
          </div>
        </div>
      </div>
      {{/if}}
      {{/unless}}
    </div>
  {{/if}}
</div>
